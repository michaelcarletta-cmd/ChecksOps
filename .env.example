# ChecksOps environment template
#
# Production/staging frontend is AWS Cognito + /prep.
# Copy values from .env.production.aws.example privately for an AWS SPA build.
# Do not copy that file over .env.production.

# VITE_AUTH_PROVIDER=cognito
# VITE_APP_URL=https://staging.checksops.com
# VITE_CHECKSOPS_API_URL=/prep
# VITE_AWS_REGION=us-east-1
# VITE_COGNITO_USER_POOL_ID=
# VITE_COGNITO_USER_POOL_CLIENT_ID=

# Historical Lovable/Supabase values. Not used by npm run build:aws.
# Keep empty unless you are debugging the frozen legacy bundle path.
# Never commit personal access tokens or service-role secrets.
SUPABASE_ACCESS_TOKEN=""
SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_URL=""
VITE_SUPABASE_PROJECT_ID=""
VITE_SUPABASE_PUBLISHABLE_KEY=""
VITE_SUPABASE_URL=""
