# .env — committed, public client values only. Lovable's build server reads
# these VITE_ vars at build time (see src/integrations/supabase/client.ts).
# These are anon/publishable keys, designed to ship in the client bundle and
# protected by RLS, not secrecy.
VITE_SUPABASE_PROJECT_ID="your-project-ref"
VITE_SUPABASE_PUBLISHABLE_KEY="eyJ..."
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"

# .env.local — gitignored, local/CLI use only. Never commit these.
# SUPABASE_ACCESS_TOKEN="sbp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# SUPABASE_PUBLISHABLE_KEY="eyJ..."
# SUPABASE_URL="https://your-project-ref.supabase.co"
