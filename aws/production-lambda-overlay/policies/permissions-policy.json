{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "InspectExactProductionApiLambda",
      "Effect": "Allow",
      "Action": [
        "lambda:GetFunction",
        "lambda:GetFunctionConfiguration"
      ],
      "Resource": "arn:aws:lambda:us-east-1:806168576068:function:checksops-production-prep-api"
    },
    {
      "Sid": "UpdateCodeOnlyExactProductionApiLambda",
      "Effect": "Allow",
      "Action": "lambda:UpdateFunctionCode",
      "Resource": "arn:aws:lambda:us-east-1:806168576068:function:checksops-production-prep-api"
    },
    {
      "Sid": "UpdateEnvironmentOnlyExactProductionApiLambda",
      "Effect": "Allow",
      "Action": "lambda:UpdateFunctionConfiguration",
      "Resource": "arn:aws:lambda:us-east-1:806168576068:function:checksops-production-prep-api"
    },
    {
      "Sid": "InspectExactProductionHttpApiCors",
      "Effect": "Allow",
      "Action": "apigateway:GET",
      "Resource": [
        "arn:aws:apigateway:us-east-1::/apis/kiqojucc02",
        "arn:aws:apigateway:us-east-1::/apis/kiqojucc02/routes",
        "arn:aws:apigateway:us-east-1::/apis/kiqojucc02/authorizers"
      ]
    },
    {
      "Sid": "UpdateCorsOnlyExactProductionHttpApi",
      "Effect": "Allow",
      "Action": "apigateway:PATCH",
      "Resource": "arn:aws:apigateway:us-east-1::/apis/kiqojucc02"
    },
    {
      "Sid": "InspectExactProductionDistribution",
      "Effect": "Allow",
      "Action": "cloudfront:GetDistribution",
      "Resource": "arn:aws:cloudfront::806168576068:distribution/E1B0ZWWO5559U5"
    },
    {
      "Sid": "InspectExactCheckAltStatusScheduleStack",
      "Effect": "Allow",
      "Action": [
        "cloudformation:DescribeStacks",
        "cloudformation:DescribeStackEvents",
        "cloudformation:DescribeStackResources",
        "cloudformation:GetTemplate"
      ],
      "Resource": "arn:aws:cloudformation:us-east-1:806168576068:stack/checksops-production-checkalt-status-schedule/*"
    },
    {
      "Sid": "CreateExactCheckAltStatusScheduleStack",
      "Effect": "Allow",
      "Action": "cloudformation:CreateStack",
      "Resource": "arn:aws:cloudformation:us-east-1:806168576068:stack/checksops-production-checkalt-status-schedule/*"
    },
    {
      "Sid": "UpdateExactCheckAltStatusScheduleStack",
      "Effect": "Allow",
      "Action": "cloudformation:UpdateStack",
      "Resource": "arn:aws:cloudformation:us-east-1:806168576068:stack/checksops-production-checkalt-status-schedule/*"
    },
    {
      "Sid": "InspectExactCheckAltStatusScheduleRole",
      "Effect": "Allow",
      "Action": [
        "iam:GetRole",
        "iam:GetRolePolicy"
      ],
      "Resource": "arn:aws:iam::806168576068:role/checksops-production-checkalt-status-schedule"
    },
    {
      "Sid": "CreateExactCheckAltStatusScheduleRole",
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole",
        "iam:PutRolePolicy",
        "iam:TagRole"
      ],
      "Resource": "arn:aws:iam::806168576068:role/checksops-production-checkalt-status-schedule"
    },
    {
      "Sid": "PassCheckAltStatusScheduleRoleToSchedulerOnly",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::806168576068:role/checksops-production-checkalt-status-schedule",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "scheduler.amazonaws.com"
        }
      }
    },
    {
      "Sid": "InspectExactCheckAltStatusSchedule",
      "Effect": "Allow",
      "Action": "scheduler:GetSchedule",
      "Resource": "arn:aws:scheduler:us-east-1:806168576068:schedule/default/checksops-production-checkalt-status-reconcile"
    },
    {
      "Sid": "CreateUpdateExactCheckAltStatusSchedule",
      "Effect": "Allow",
      "Action": [
        "scheduler:CreateSchedule",
        "scheduler:UpdateSchedule"
      ],
      "Resource": "arn:aws:scheduler:us-east-1:806168576068:schedule/default/checksops-production-checkalt-status-reconcile"
    },
    {
      "Sid": "SignDeploymentGuardReceiptsExactProductionKey",
      "Effect": "Allow",
      "Action": [
        "kms:Sign",
        "kms:GetPublicKey"
      ],
      "Resource": "arn:aws:kms:us-east-1:806168576068:key/REPLACE_WITH_PRODUCTION_DEPLOYMENT_GUARD_KEY_ID"
    }
  ]
}
