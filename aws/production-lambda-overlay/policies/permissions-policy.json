{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "InspectExactProductionApiLambda",
      "Effect": "Allow",
      "Action": [
        "lambda:GetFunction",
        "lambda:GetFunctionConfiguration"
      ],
      "Resource": "arn:aws:lambda:us-east-1:806168576068:function:checksops-production-prep-api"
    },
    {
      "Sid": "UpdateCodeOnlyExactProductionApiLambda",
      "Effect": "Allow",
      "Action": "lambda:UpdateFunctionCode",
      "Resource": "arn:aws:lambda:us-east-1:806168576068:function:checksops-production-prep-api"
    },
    {
      "Sid": "UpdateEnvironmentOnlyExactProductionApiLambda",
      "Effect": "Allow",
      "Action": "lambda:UpdateFunctionConfiguration",
      "Resource": "arn:aws:lambda:us-east-1:806168576068:function:checksops-production-prep-api"
    },
    {
      "Sid": "InspectExactProductionHttpApiCors",
      "Effect": "Allow",
      "Action": "apigateway:GET",
      "Resource": [
        "arn:aws:apigateway:us-east-1::/apis/kiqojucc02",
        "arn:aws:apigateway:us-east-1::/apis/kiqojucc02/routes",
        "arn:aws:apigateway:us-east-1::/apis/kiqojucc02/authorizers"
      ]
    },
    {
      "Sid": "UpdateCorsOnlyExactProductionHttpApi",
      "Effect": "Allow",
      "Action": "apigateway:PATCH",
      "Resource": "arn:aws:apigateway:us-east-1::/apis/kiqojucc02"
    },
    {
      "Sid": "InspectExactProductionDistribution",
      "Effect": "Allow",
      "Action": "cloudfront:GetDistribution",
      "Resource": "arn:aws:cloudfront::806168576068:distribution/E1B0ZWWO5559U5"
    },
    {
      "Sid": "SignDeploymentGuardReceiptsExactProductionKey",
      "Effect": "Allow",
      "Action": [
        "kms:Sign",
        "kms:GetPublicKey"
      ],
      "Resource": "arn:aws:kms:us-east-1:806168576068:key/REPLACE_WITH_PRODUCTION_DEPLOYMENT_GUARD_KEY_ID"
    }
  ]
}
