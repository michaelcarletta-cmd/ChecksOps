{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DenyStagingApiRole",
      "Effect": "Deny",
      "Principal": {
        "AWS": "arn:aws:iam::806168576068:role/checksops-staging-ApiFunctionRole-7E7XRyLe3nyi"
      },
      "Action": "s3:*",
      "Resource": [
        "arn:aws:s3:::checksops-production-privatefiles-806168576068",
        "arn:aws:s3:::checksops-production-privatefiles-806168576068/*"
      ]
    },
    {
      "Sid": "E7AllowPrepApiReadSign",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::806168576068:role/checksops-production-api-execution"
      },
      "Action": [
        "s3:GetObject",
        "s3:GetObjectVersion",
        "s3:GetBucketLocation",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::checksops-production-privatefiles-806168576068",
        "arn:aws:s3:::checksops-production-privatefiles-806168576068/*"
      ]
    },
    {
      "Sid": "E14AAllowPrepApiObjectWrite",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::806168576068:role/checksops-production-api-execution"
      },
      "Action": [
        "s3:PutObject",
        "s3:DeleteObject",
        "s3:DeleteObjectVersion",
        "s3:AbortMultipartUpload"
      ],
      "Resource": [
        "arn:aws:s3:::checksops-production-privatefiles-806168576068/*"
      ]
    }
  ]
}
