{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListProductionFrontendBucketForSync",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:GetBucketLocation",
        "s3:ListBucketMultipartUploads"
      ],
      "Resource": "arn:aws:s3:::checksops-production-frontend-806168576068"
    },
    {
      "Sid": "WriteProductionFrontendObjects",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject",
        "s3:AbortMultipartUpload",
        "s3:ListMultipartUploadParts"
      ],
      "Resource": "arn:aws:s3:::checksops-production-frontend-806168576068/*"
    },
    {
      "Sid": "InvalidateProductionSpaDistribution",
      "Effect": "Allow",
      "Action": "cloudfront:CreateInvalidation",
      "Resource": "arn:aws:cloudfront::806168576068:distribution/E1B0ZWWO5559U5"
    }
  ]
}
