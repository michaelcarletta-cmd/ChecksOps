{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadAndUpdateProductionSpaDistribution",
      "Effect": "Allow",
      "Action": [
        "cloudfront:GetDistribution",
        "cloudfront:GetDistributionConfig",
        "cloudfront:UpdateDistribution",
        "cloudfront:CreateInvalidation",
        "cloudfront:GetInvalidation",
        "cloudfront:ListInvalidations"
      ],
      "Resource": "arn:aws:cloudfront::806168576068:distribution/E1B0ZWWO5559U5"
    },
    {
      "Sid": "SpaFallbackFunctionOnly",
      "Effect": "Allow",
      "Action": [
        "cloudfront:CreateFunction",
        "cloudfront:UpdateFunction",
        "cloudfront:PublishFunction",
        "cloudfront:DescribeFunction",
        "cloudfront:GetFunction"
      ],
      "Resource": "arn:aws:cloudfront::806168576068:function/checksops-production-spa-fallback"
    },
    {
      "Sid": "ListCloudFrontFunctions",
      "Effect": "Allow",
      "Action": "cloudfront:ListFunctions",
      "Resource": "*"
    },
    {
      "Sid": "ProductionFrontendBucketList",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:GetBucketLocation"
      ],
      "Resource": "arn:aws:s3:::checksops-production-frontend-806168576068"
    },
    {
      "Sid": "ProductionFrontendObjects",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:GetObjectVersion",
        "s3:PutObject",
        "s3:DeleteObject",
        "s3:AbortMultipartUpload"
      ],
      "Resource": "arn:aws:s3:::checksops-production-frontend-806168576068/*"
    }
  ]
}
