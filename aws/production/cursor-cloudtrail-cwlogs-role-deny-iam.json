{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DenyCloudTrailCreateDeleteSelectors",
      "Effect": "Deny",
      "Action": [
        "cloudtrail:CreateTrail",
        "cloudtrail:DeleteTrail",
        "cloudtrail:StartLogging",
        "cloudtrail:StopLogging",
        "cloudtrail:PutEventSelectors",
        "cloudtrail:PutInsightSelectors"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DenyUpdateTrailExceptMgmtEvents",
      "Effect": "Deny",
      "Action": "cloudtrail:UpdateTrail",
      "NotResource": "arn:aws:cloudtrail:us-east-1:806168576068:trail/checksops-production-mgmt-events"
    },
    {
      "Sid": "DenyUnrelatedIamMutation",
      "Effect": "Deny",
      "Action": [
        "iam:CreateUser",
        "iam:DeleteUser",
        "iam:CreateAccessKey",
        "iam:CreateLoginProfile",
        "iam:UpdateLoginProfile",
        "iam:ChangePassword",
        "iam:CreatePolicy",
        "iam:CreatePolicyVersion",
        "iam:DeletePolicy",
        "iam:AttachUserPolicy",
        "iam:PutUserPolicy",
        "iam:CreateRole",
        "iam:DeleteRole",
        "iam:PutRolePolicy",
        "iam:UpdateAssumeRolePolicy",
        "iam:PassRole",
        "iam:TagRole",
        "iam:UntagRole"
      ],
      "NotResource": "arn:aws:iam::806168576068:role/checksops-production-cloudtrail-cwlogs"
    },
    {
      "Sid": "DenyAttachManagedPolicies",
      "Effect": "Deny",
      "Action": [
        "iam:AttachRolePolicy",
        "iam:DetachRolePolicy",
        "iam:AttachUserPolicy",
        "iam:DetachUserPolicy",
        "iam:AttachGroupPolicy",
        "iam:DetachGroupPolicy"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DenyPassRoleExceptCloudTrailService",
      "Effect": "Deny",
      "Action": "iam:PassRole",
      "Resource": "*",
      "Condition": {
        "StringNotEquals": {
          "iam:PassedToService": "cloudtrail.amazonaws.com"
        }
      }
    },
    {
      "Sid": "DenyProtectedCloudFormationStacks",
      "Effect": "Deny",
      "Action": [
        "cloudformation:CreateStack",
        "cloudformation:UpdateStack",
        "cloudformation:DeleteStack",
        "cloudformation:CreateChangeSet",
        "cloudformation:ExecuteChangeSet",
        "cloudformation:ContinueUpdateRollback"
      ],
      "Resource": [
        "arn:aws:cloudformation:us-east-1:806168576068:stack/checksops-production-security-trail/*",
        "arn:aws:cloudformation:us-east-1:806168576068:stack/checksops-production-cloudtrail/*",
        "arn:aws:cloudformation:us-east-1:806168576068:stack/checksops-production-prep-api/*",
        "arn:aws:cloudformation:us-east-1:806168576068:stack/checksops-production-spa/*",
        "arn:aws:cloudformation:us-east-1:806168576068:stack/checksops-production-http-api/*",
        "arn:aws:cloudformation:us-east-1:806168576068:stack/checksops-cursor-security-hardening-role/*",
        "arn:aws:cloudformation:us-east-1:806168576068:stack/checksops-cursor-cloudtrail-cwlogs-role/*",
        "arn:aws:cloudformation:us-east-1:806168576068:stack/checksops-production-security-sns/*",
        "arn:aws:cloudformation:us-east-1:806168576068:stack/checksops-production-security-config/*",
        "arn:aws:cloudformation:us-east-1:806168576068:stack/checksops-production-security-posture/*",
        "arn:aws:cloudformation:us-east-1:806168576068:stack/checksops-production-security-flow/*",
        "arn:aws:cloudformation:us-east-1:806168576068:stack/checksops-production-security-alarms/*"
      ]
    },
    {
      "Sid": "DenyProtectedLogGroups",
      "Effect": "Deny",
      "Action": [
        "logs:DeleteLogGroup",
        "logs:DeleteMetricFilter",
        "logs:PutMetricFilter",
        "logs:DeleteRetentionPolicy",
        "logs:PutRetentionPolicy",
        "logs:CreateLogGroup"
      ],
      "Resource": [
        "arn:aws:logs:us-east-1:806168576068:log-group:/aws/lambda/checksops-production-prep-api",
        "arn:aws:logs:us-east-1:806168576068:log-group:/aws/lambda/checksops-production-prep-api:*",
        "arn:aws:logs:us-east-1:806168576068:log-group:/aws/apigateway/checksops-production-prep-http",
        "arn:aws:logs:us-east-1:806168576068:log-group:/aws/apigateway/checksops-production-prep-http:*",
        "arn:aws:logs:us-east-1:806168576068:log-group:/aws/vpc/checksops-production-flow",
        "arn:aws:logs:us-east-1:806168576068:log-group:/aws/vpc/checksops-production-flow:*"
      ]
    },
    {
      "Sid": "DenyRoleChaining",
      "Effect": "Deny",
      "Action": [
        "sts:AssumeRole",
        "sts:AssumeRoleWithSAML",
        "sts:AssumeRoot"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DenyOtherDetectionMutation",
      "Effect": "Deny",
      "Action": [
        "sns:CreateTopic",
        "sns:DeleteTopic",
        "sns:Subscribe",
        "cloudwatch:PutMetricAlarm",
        "cloudwatch:DeleteAlarms",
        "config:PutConfigurationRecorder",
        "config:DeleteConfigurationRecorder",
        "config:PutDeliveryChannel",
        "guardduty:CreateDetector",
        "guardduty:DeleteDetector",
        "guardduty:UpdateDetector",
        "securityhub:EnableSecurityHub",
        "securityhub:DisableSecurityHub",
        "ec2:CreateFlowLogs",
        "ec2:DeleteFlowLogs"
      ],
      "Resource": "*"
    }
  ]
}
