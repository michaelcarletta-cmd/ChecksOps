{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadAndUpdateNamedDistributionOrigin",
      "Effect": "Allow",
      "Action": [
        "cloudfront:GetDistribution",
        "cloudfront:GetDistributionConfig",
        "cloudfront:UpdateDistribution"
      ],
      "Resource": "arn:aws:cloudfront::806168576068:distribution/E1B0ZWWO5559U5"
    },
    {
      "Sid": "OriginVerifyLambdaOnly",
      "Effect": "Allow",
      "Action": [
        "lambda:CreateFunction",
        "lambda:UpdateFunctionCode",
        "lambda:UpdateFunctionConfiguration",
        "lambda:GetFunction",
        "lambda:GetFunctionConfiguration",
        "lambda:AddPermission",
        "lambda:RemovePermission",
        "lambda:GetPolicy",
        "lambda:TagResource",
        "lambda:ListTags"
      ],
      "Resource": [
        "arn:aws:lambda:us-east-1:806168576068:function:checksops-production-origin-verify",
        "arn:aws:lambda:us-east-1:806168576068:function:checksops-production-origin-verify:*"
      ]
    },
    {
      "Sid": "PassAuthorizerExecutionRole",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::806168576068:role/checksops-production-origin-verify",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "lambda.amazonaws.com"
        }
      }
    },
    {
      "Sid": "ReadAuthorizerExecutionRole",
      "Effect": "Allow",
      "Action": [
        "iam:GetRole",
        "iam:GetRolePolicy"
      ],
      "Resource": "arn:aws:iam::806168576068:role/checksops-production-origin-verify"
    },
    {
      "Sid": "HttpApiAuthorizerRouteIntegrationOnly",
      "Effect": "Allow",
      "Action": [
        "apigateway:GET",
        "apigateway:POST",
        "apigateway:PATCH",
        "apigateway:DELETE"
      ],
      "Resource": [
        "arn:aws:apigateway:us-east-1::/apis/kiqojucc02/authorizers",
        "arn:aws:apigateway:us-east-1::/apis/kiqojucc02/authorizers/*",
        "arn:aws:apigateway:us-east-1::/apis/kiqojucc02/routes",
        "arn:aws:apigateway:us-east-1::/apis/kiqojucc02/routes/*",
        "arn:aws:apigateway:us-east-1::/apis/kiqojucc02/integrations/jci10de"
      ]
    },
    {
      "Sid": "HttpApiReadOnly",
      "Effect": "Allow",
      "Action": "apigateway:GET",
      "Resource": [
        "arn:aws:apigateway:us-east-1::/apis/kiqojucc02",
        "arn:aws:apigateway:us-east-1::/apis/kiqojucc02/*"
      ]
    },
    {
      "Sid": "OriginVerifySecretOnly",
      "Effect": "Allow",
      "Action": [
        "secretsmanager:CreateSecret",
        "secretsmanager:DescribeSecret",
        "secretsmanager:GetSecretValue",
        "secretsmanager:PutSecretValue"
      ],
      "Resource": "arn:aws:secretsmanager:us-east-1:806168576068:secret:checksops/production/cloudfront-origin-verify*"
    },
    {
      "Sid": "AuthorizerLogs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:CreateLogStream",
        "logs:PutLogEvents",
        "logs:DescribeLogGroups",
        "logs:DescribeLogStreams",
        "logs:FilterLogEvents",
        "logs:GetLogEvents"
      ],
      "Resource": [
        "arn:aws:logs:us-east-1:806168576068:log-group:/aws/lambda/checksops-production-origin-verify",
        "arn:aws:logs:us-east-1:806168576068:log-group:/aws/lambda/checksops-production-origin-verify:*"
      ]
    },
    {
      "Sid": "ReadApiAccessLogsNoFormatChange",
      "Effect": "Allow",
      "Action": [
        "logs:DescribeLogStreams",
        "logs:FilterLogEvents",
        "logs:GetLogEvents"
      ],
      "Resource": "arn:aws:logs:us-east-1:806168576068:log-group:/aws/apigateway/checksops-production-prep-http:*"
    }
  ]
}
