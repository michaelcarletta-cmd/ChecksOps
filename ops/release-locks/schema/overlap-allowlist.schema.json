{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "https://checksops.local/ops/release-locks/overlap-allowlist.schema.json",
  "title": "ChecksOps protected-path overlap allowlist",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "fail_closed", "allow"],
  "properties": {
    "version": { "type": "integer", "const": 1 },
    "fail_closed": { "type": "boolean", "const": true },
    "notes": { "type": "string" },
    "allow": {
      "type": "array",
      "items": { "$ref": "#/definitions/exception" }
    }
  },
  "definitions": {
    "exception": {
      "type": "object",
      "additionalProperties": false,
      "required": ["other_pr", "path", "reason"],
      "properties": {
        "other_pr": { "type": "integer", "minimum": 1 },
        "path": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 20 },
        "expires": { "type": "string", "minLength": 1 },
        "review_condition": { "type": "string", "minLength": 8 }
      }
    }
  }
}
