{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "https://checksops.local/ops/release-locks/protected-paths.schema.json",
  "title": "ChecksOps protected-path ownership mapping",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "fail_closed",
    "ownership_groups",
    "control_plane_group",
    "unowned_file_watches"
  ],
  "properties": {
    "version": { "type": "integer", "const": 1 },
    "fail_closed": { "type": "boolean", "const": true },
    "codeowners_file": { "type": "string", "minLength": 1 },
    "control_plane_group": { "type": "string", "minLength": 1 },
    "unowned_file_watches": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "ownership_groups": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/definitions/group" }
    }
  },
  "definitions": {
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owners", "paths"],
      "properties": {
        "owners": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "description": { "type": "string" },
        "control_plane": { "type": "boolean" },
        "tree_hash_exclude": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "paths": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
