    },
    {
      "AllowedHeaders": [
        "content-type",
        "content-length",
        "x-amz-server-side-encryption",
        "x-amz-server-side-encryption-aws-kms-key-id"
      ],
      "AllowedMethods": [
        "PUT"
      ],
      "AllowedOrigins": [
        "https://checksops.com",
        "https://www.checksops.com"
      ],
      "MaxAgeSeconds": 300
    }
  ]
}
