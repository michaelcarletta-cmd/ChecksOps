{
  "CORSRules": [
    {
      "AllowedHeaders": [
        "*"
      ],
      "AllowedMethods": [
        "GET",
        "HEAD"
      ],
      "AllowedOrigins": [
        "https://checksops.com",
        "https://www.checksops.com"
      ],
      "ExposeHeaders": [
        "Content-Type",
        "Content-Length",
        "ETag",
        "Content-Disposition"
      ],
