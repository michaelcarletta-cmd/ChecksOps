        "zero claim_settlements or owner accepts in-place update of that UAT row only",
        "zero homeowner_ledger_events for that claim_id"
      ]
    },
    "step_2_create_unlinked_check": {
      "method": "POST",
      "path": "/workflow/checks",
      "body": {
        "carrier_name": "AWS SETTLEMENT UAT",
        "review_notes": "AWS SETTLEMENT UAT",
        "check_number": "UAT-SETTLEMENT",
        "detected_claim_number": null,
