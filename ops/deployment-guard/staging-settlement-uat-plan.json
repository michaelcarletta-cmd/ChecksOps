        "claim_id": null,
        "ocrInvoked": false,
        "providerSubmitted": false
      },
      "guards": [
        "never set claim_id on insert",
        "never set detected_claim_number",
        "never set amount",
        "never insert check_messages after later link"
      ]
    },
    "step_3_create_claim": {
      "method": "POST",
      "path": "/data/rpc",
      "body": {
        "name": "claim_ledger_link_or_create",
        "args": {
          "p_check_id": "<synthetic_check_id>",
          "p_action": "create_new",
          "p_claim_number": "AWS SETTLEMENT UAT"
        }
      },
      "note": "This is the approved create path. Generic /data/write claims insert is denied. Do not modify SQL 44. Use the live function only.",
      "expected": {
        "ok": true,
        "claim_number": "AWS SETTLEMENT UAT",
        "org_id": "2eff5f1a-929d-4ce3-9a8b-cd96b98df42a"
      },
      "stop_if": "homeowner_ledger_events count for the new claim_id is not 0"
