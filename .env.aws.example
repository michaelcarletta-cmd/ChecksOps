# ChecksOps AWS migration environment template
# Never commit real credentials or private provider secrets.
# Copy to `.env.aws` for `vite build --mode aws` / `vite --mode aws`.

# Staging-only frontend switch. Production `.env.production` must not set this.
VITE_AUTH_PROVIDER=cognito

# Public identifiers only. Never put RDS passwords, AWS keys, or provider secrets here.
# Cognito WebAuthn RP ID is staging.checksops.com — passkeys enable only on this HTTPS origin.
VITE_APP_URL=https://staging.checksops.com
VITE_CHECKSOPS_API_URL=https://psr19uhop4.execute-api.us-east-1.amazonaws.com/staging
VITE_AWS_REGION=us-east-1
VITE_COGNITO_USER_POOL_ID=us-east-1_vPmQ7cL1F
VITE_COGNITO_USER_POOL_CLIENT_ID=71bb7a192cbl6o6s8m259tl589

# Server-side only. Store these in AWS Secrets Manager/deployment secrets.
# They must never appear in Vite VITE_* variables or the browser bundle.
DATABASE_URL=
CHECKSOPS_FILES_BUCKET=
MOOV_CLIENT_ID=
MOOV_CLIENT_SECRET=
MOOV_WEBHOOK_SECRET=
CHECKALT_API_KEY=
CHECKALT_WEBHOOK_SECRET=
RESEND_API_KEY=
PLAID_CLIENT_ID=
PLAID_SECRET=
